// Скопируйте файл в .env и заполните значения. Сам .env не попадает в репозиторий.
//
// 1. Создайте бота у @BotFather и скопируйте токен.
// 2. Напишите боту любое сообщение, затем откройте
//    https://api.telegram.org/bot<ТОКЕН>/getUpdates и возьмите message.chat.id
// 3. Заполните значения ниже и перезапустите npm run dev.

TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
